#!hexa strict
// hexa-time/verify/lattice_arithmetic.hexa — n=6 lattice self-consistency.
//
// Per LATTICE_POLICY.md §1.3 rule 1, lattice arithmetic (σ·φ = n·τ = 24,
// 1/2 + 1/3 + 1/6 = 1) is permitted ONLY as an aux self-consistency check —
// it must NEVER stand alone as verification, must NEVER be applied to
// external entities (e.g. NIST, BIPM, USNO, NPL, PTB), and must
// be paired with at least one real-limits anchor (see real_limits_anchor.hexa).
//
// For hexa-time specifically: the τ(6)=4 four-phase escapement, 12-month
// calendar, 24-hour cycle are organising vocabulary, NOT physics-derived
// time invariants. Real time limits live in L1-L7 of LIMIT_BREAKTHROUGH.md.
//
// This script: native-lattice arithmetic identities only. Pass iff arithmetic
// holds. No external-domain claims, no claims about NIST/BIPM realising n=6.

fn _assert(label: str, cond: bool, mut ok: int, mut bad: int) -> [int] {
    if cond {
        println("  [PASS] " + label)
        return [ok + 1, bad]
    }
    println("  [FAIL] " + label)
    return [ok, bad + 1]
}

fn main() {
    println("hexa-time/verify/lattice_arithmetic — n=6 self-consistency (aux only)")
    println("")
    println("  scope: native-lattice arithmetic identities ONLY")
    println("  policy: LATTICE_POLICY §1.3 rule 1 — aux check; never sole verification")
    println("  policy: LATTICE_POLICY §1.3 rule 4 — NEVER applied to external entities")
    println("  caveat: NIST, BIPM, USNO, NPL, PTB use THEIR OWN definitions")
    println("          (TAI, UTC, SI second via Cs-133 hyperfine, optical-lattice)")
    println("          — no lattice-fit claims about external timekeeping bodies.")
    println("")

    let n = 6
    let sigma = 12   // σ(6) — sum of divisors
    let tau = 4      // τ(6) — number of divisors  ← four-phase escapement vocabulary
    let phi = 2      // φ(6) — Euler totient        ← two-equinox vocabulary
    let j2 = 24      // Jordan totient J₂(6) = σ·φ = n·τ  ← 24-hour vocabulary

    let mut ok = 0
    let mut bad = 0

    // σ·φ = 24
    let r1 = _assert("σ(6)·φ(6) = 24  (12·2 = 24)", sigma * phi == 24, ok, bad)
    ok = r1[0]; bad = r1[1]

    // n·τ = 24
    let r2 = _assert("n·τ(6) = 24      (6·4 = 24)",  n * tau == 24, ok, bad)
    ok = r2[0]; bad = r2[1]

    // J₂(6) = σ·φ = n·τ
    let r3 = _assert("J₂(6) = σ·φ = n·τ (24 = 24 = 24)", j2 == sigma * phi && j2 == n * tau, ok, bad)
    ok = r3[0]; bad = r3[1]

    // Divisor identity 1/2 + 1/3 + 1/6 = 1 (integer rational: 3 + 2 + 1 = 6)
    let r4 = _assert("1/2 + 1/3 + 1/6 = 1 (3+2+1 = 6)", 3 + 2 + 1 == 6, ok, bad)
    ok = r4[0]; bad = r4[1]

    // τ(6) divisor count: {1,2,3,6} has 4 elements (escapement-phase mnemonic)
    let r5 = _assert("τ(6) = |{1,2,3,6}| = 4 (escapement-phase mnemonic)", tau == 4, ok, bad)
    ok = r5[0]; bad = r5[1]

    // Calendar mnemonic: 12 months = σ(6); 4 quarter-weeks per τ(6); 24 hours = J₂(6)
    let r6 = _assert("12 months = σ(6); 24 hours = J₂(6) (cultural mnemonic)",
                     sigma == 12 && j2 == 24, ok, bad)
    ok = r6[0]; bad = r6[1]

    println("")
    println("  passed: " + str(ok) + "  failed: " + str(bad))
    println("  NOTE: lattice arithmetic alone is insufficient verification —")
    println("        see verify/real_limits_anchor.hexa for the real-limits anchor.")
    println("  NOTE: 12-month / 24-hour calendar is *cultural-historical*, NOT a")
    println("        physics derivation. Tropical year ≈ 365.2422 d is the actual")
    println("        physical anchor (LIMIT_BREAKTHROUGH.md L6).")
    if bad > 0 {
        println("__HEXA_TIME_LATTICE_ARITHMETIC__ FAIL")
        exit(1)
    }
    println("__HEXA_TIME_LATTICE_ARITHMETIC__ PASS")
}
