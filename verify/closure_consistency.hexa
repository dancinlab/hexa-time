#!hexa strict
// hexa-time/verify/closure_consistency.hexa — scoreboard cross-check.
//
// Confirms three sources agree on the 3-verb count (spec-first):
//   1. cli/hexa-time.hexa SPEC_* declarations  (registry of record)
//   2. hexa.toml [closure] verbs_total / verbs_spec
//   3. README.md badge "verbs-0/3_wired" + status
//
// Per LATTICE_POLICY §1.3 rule 4: this is *internal* self-consistency
// (own substrate's own scoreboard), NOT a claim about external entities
// (NIST, BIPM, USNO, NPL, PTB all use their own definitions, not n=6).

let HOME = env("HOME")
let HEXA_TIME_ROOT_ENV = env("HEXA_TIME_ROOT")

fn shq(s: str) -> str {
    return "'" + s.replace("'", "'\\''") + "'"
}

fn _resolve_root() -> str {
    if HEXA_TIME_ROOT_ENV.len() > 0 { return HEXA_TIME_ROOT_ENV }
    let oldpwd = env("OLDPWD")
    if oldpwd.len() > 0 {
        let t = exec("[ -f " + shq(oldpwd) + "/hexa.toml ] && echo y || echo n").trim()
        if t == "y" { return oldpwd }
    }
    let pwd = env("PWD")
    if pwd.len() > 0 {
        let t = exec("[ -f " + shq(pwd) + "/hexa.toml ] && echo y || echo n").trim()
        if t == "y" { return pwd }
    }
    return HOME + "/core/hexa-time"
}

fn _count_cli_spec_decls(root: str) -> int {
    let cli = root + "/cli/hexa-time.hexa"
    // Match `let SPEC_<NAME>  = HT + ...`
    let raw = exec("grep -cE '^let SPEC_[A-Z]+ *= *HT \\+' " + shq(cli)).trim()
    if raw.len() == 0 { return -1 }
    return int(raw)
}

fn _toml_int(root: str, key: str) -> int {
    let toml = root + "/hexa.toml"
    let cmd = "awk -F'=' '/^" + key + " *=/ {gsub(/[^0-9]/,\"\",$2); print $2; exit}' " + shq(toml)
    let raw = exec(cmd).trim()
    if raw.len() == 0 { return -1 }
    return int(raw)
}

fn _readme_verb_badge(root: str) -> int {
    let readme = root + "/README.md"
    // README badge form: "verbs-0%2F3_wired" → extract second integer (total)
    let cmd = "grep -oE 'verbs-[0-9]+%2F[0-9]+' " + shq(readme) + " | head -1 | grep -oE '[0-9]+' | tail -1"
    let raw = exec(cmd).trim()
    if raw.len() == 0 { return -1 }
    return int(raw)
}

fn _file_contains(p: str, needle: str) -> bool {
    let cmd = "grep -F " + shq(needle) + " " + shq(p) + " >/dev/null 2>&1 && echo yes || echo no"
    return exec(cmd).trim() == "yes"
}

fn main() {
    let root = _resolve_root()
    println("hexa-time/verify/closure_consistency — scoreboard cross-check")
    println("  root: " + root)
    println("")

    let mut ok = 0
    let mut bad = 0

    let cli_n = _count_cli_spec_decls(root)
    let toml_total = _toml_int(root, "verbs_total")
    let toml_spec = _toml_int(root, "verbs_spec")
    let readme_n = _readme_verb_badge(root)

    println("  cli/hexa-time.hexa SPEC_* decls:  " + str(cli_n))
    println("  hexa.toml verbs_total:            " + str(toml_total))
    println("  hexa.toml verbs_spec:             " + str(toml_spec))
    println("  README badge verbs-N/M_wired:     " + str(readme_n))
    println("")

    if cli_n == 3 {
        println("  [PASS] CLI registry has 3 SPEC_* declarations")
        ok = ok + 1
    } else {
        println("  [FAIL] CLI registry has " + str(cli_n) + " SPEC_* decls (expected 3)")
        bad = bad + 1
    }
    if toml_total == 3 {
        println("  [PASS] hexa.toml verbs_total = 3")
        ok = ok + 1
    } else {
        println("  [FAIL] hexa.toml verbs_total = " + str(toml_total))
        bad = bad + 1
    }
    if toml_spec == 3 {
        println("  [PASS] hexa.toml verbs_spec = 3")
        ok = ok + 1
    } else {
        println("  [FAIL] hexa.toml verbs_spec = " + str(toml_spec))
        bad = bad + 1
    }
    if readme_n == 3 {
        println("  [PASS] README badge verbs-N/3_wired")
        ok = ok + 1
    } else {
        println("  [FAIL] README badge verbs-N/" + str(readme_n) + "_wired (expected /3)")
        bad = bad + 1
    }

    // Standard policy artifacts must be present.
    let must = ["LATTICE_POLICY.md", "LIMIT_BREAKTHROUGH.md", "AGENTS.md", "hexa.toml", "README.md", "LICENSE", "CITATION.cff"]
    for f in must {
        let abs_f = root + "/" + f
        let cmd = "[ -f " + shq(abs_f) + " ] && echo y || echo n"
        if exec(cmd).trim() == "y" {
            println("  [PASS] standard artifact: " + f)
            ok = ok + 1
        } else {
            println("  [FAIL] standard artifact missing: " + f)
            bad = bad + 1
        }
    }

    // AGENTS.md must register LATTICE_POLICY + LIMIT_BREAKTHROUGH.
    let agents = root + "/AGENTS.md"
    if _file_contains(agents, "LATTICE_POLICY.md") {
        println("  [PASS] AGENTS.md registers LATTICE_POLICY.md")
        ok = ok + 1
    } else {
        println("  [FAIL] AGENTS.md does not register LATTICE_POLICY.md")
        bad = bad + 1
    }
    if _file_contains(agents, "LIMIT_BREAKTHROUGH.md") {
        println("  [PASS] AGENTS.md registers LIMIT_BREAKTHROUGH.md")
        ok = ok + 1
    } else {
        println("  [FAIL] AGENTS.md does not register LIMIT_BREAKTHROUGH.md")
        bad = bad + 1
    }

    // README.md must include §Verify section pointing to verify/run_all.hexa
    let readme = root + "/README.md"
    if _file_contains(readme, "verify/run_all.hexa") {
        println("  [PASS] README.md references verify/run_all.hexa")
        ok = ok + 1
    } else {
        println("  [FAIL] README.md does not reference verify/run_all.hexa")
        bad = bad + 1
    }

    // hexa.toml must declare verdict = "SPEC_FIRST"
    let toml = root + "/hexa.toml"
    if _file_contains(toml, "SPEC_FIRST") {
        println("  [PASS] hexa.toml [closure] verdict = SPEC_FIRST")
        ok = ok + 1
    } else {
        println("  [FAIL] hexa.toml [closure] verdict != SPEC_FIRST")
        bad = bad + 1
    }

    println("")
    println("  passed: " + str(ok) + "  failed: " + str(bad))
    if bad > 0 {
        println("__HEXA_TIME_CLOSURE_CONSISTENCY__ FAIL")
        exit(1)
    }
    println("__HEXA_TIME_CLOSURE_CONSISTENCY__ PASS")
}
