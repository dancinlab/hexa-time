#!hexa strict
// hexa-time/verify/real_limits_anchor.hexa — real-limits-first anchor.
//
// Per LATTICE_POLICY.md §1.3 rule 2: each project's verify must use at
// least one anchor from §1.2 (Shannon · Kolmogorov · Bekenstein · c · ℏ ·
// k · Stefan-Boltzmann · Carnot · ASML throughput · ERCOT · etc.) and
// at least one engineering/industry threshold.
//
// hexa-time's real-limits audit lives in LIMIT_BREAKTHROUGH.md (Wave M,
// 2026-05-12). This script confirms that file is present and references
// the canonical time-physics HARD walls (L1–L7) so any agent has a
// pointer from verify→audit.
//
// Honesty: no value here is computed against the n=6 lattice. Each constant
// is sourced from NIST / BIPM / IERS / IAU / Einstein-1905 / Heisenberg-1927
// as cited in LIMIT_BREAKTHROUGH.md.
//
// Time-physics HARD walls anchored here:
//   - c (causality) — no FTL synchronisation
//   - Heisenberg ΔE·Δt ≥ ℏ/2 — quantum-projection noise floor
//   - Atomic clock stability — NIST-F2 (Cs) ~10⁻¹⁶, Yb optical ~10⁻¹⁹
//   - SR/GR time dilation — GPS ≈ 38 μs/day correction
//   - Planck time t_P ~ 5.39 × 10⁻⁴⁴ s — shortest physically meaningful interval
//   - Tropical year ≈ 365.2422 d (IAU 2015) — calendar physical anchor
//   - Time travel UNPROVEN — CTCs hypothetical, no experimental evidence

let HOME = env("HOME")
let HEXA_TIME_ROOT_ENV = env("HEXA_TIME_ROOT")

fn shq(s: str) -> str {
    return "'" + s.replace("'", "'\\''") + "'"
}

fn _resolve_root() -> str {
    if HEXA_TIME_ROOT_ENV.len() > 0 { return HEXA_TIME_ROOT_ENV }
    let oldpwd = env("OLDPWD")
    if oldpwd.len() > 0 {
        let t = exec("[ -f " + shq(oldpwd) + "/hexa.toml ] && echo y || echo n").trim()
        if t == "y" { return oldpwd }
    }
    let pwd = env("PWD")
    if pwd.len() > 0 {
        let t = exec("[ -f " + shq(pwd) + "/hexa.toml ] && echo y || echo n").trim()
        if t == "y" { return pwd }
    }
    return HOME + "/core/hexa-time"
}

fn _file_exists(p: str) -> bool {
    let r = exec("[ -f " + shq(p) + " ] && echo yes || echo no").trim()
    return r == "yes"
}

fn _file_contains(p: str, needle: str) -> bool {
    let cmd = "grep -F " + shq(needle) + " " + shq(p) + " >/dev/null 2>&1 && echo yes || echo no"
    let r = exec(cmd).trim()
    return r == "yes"
}

fn main() {
    let root = _resolve_root()
    println("hexa-time/verify/real_limits_anchor — real-limits-first check")
    println("  root: " + root)
    println("")
    println("  policy: LATTICE_POLICY §1.3 rule 2 — at least 1 real limit anchor required")
    println("  source: LIMIT_BREAKTHROUGH.md (Wave M, time-physics audit)")
    println("")

    let mut ok = 0
    let mut bad = 0

    // 1. Audit file must exist.
    let audit = root + "/LIMIT_BREAKTHROUGH.md"
    if _file_exists(audit) {
        println("  [PASS] LIMIT_BREAKTHROUGH.md present")
        ok = ok + 1
    } else {
        println("  [FAIL] LIMIT_BREAKTHROUGH.md missing (abs: " + audit + ")")
        bad = bad + 1
    }

    // 2. Audit must reference canonical time-physics HARD walls.
    //    Each anchor is a sourced HARD/SOFT wall from LIMIT_BREAKTHROUGH.md §2.
    let anchors = [
        ["Speed of light c (L1, causality)",            "Speed of light"],
        ["Atomic clock stability (L2, Cs/optical)",     "Atomic clock stability"],
        ["Heisenberg / SQL (L3)",                       "Heisenberg"],
        ["SR/GR time dilation (L4, GPS 38 μs/day)",     "Special / general relativity"],
        ["Leap-second / UT1-UTC drift (L5, IERS)",      "Leap-second"],
        ["Tropical year ≈ 365.2422 d (L6, IAU 2015)",   "Tropical year"],
        ["Shannon on time-tag encoding (L7)",           "Shannon on time-tag"],
        ["NIST sourcing (canonical timekeeping body)",  "NIST"],
        ["BIPM sourcing (TAI/UTC authority)",           "BIPM"],
        ["IERS sourcing (UT1-UTC, leap-second)",        "IERS"],
        ["IAU sourcing (astronomical constants)",       "IAU"],
    ]
    for a in anchors {
        let label = a[0]
        let needle = a[1]
        if _file_contains(audit, needle) {
            println("  [PASS] anchor referenced: " + label)
            ok = ok + 1
        } else {
            println("  [FAIL] anchor missing: " + label + " (needle: '" + needle + "')")
            bad = bad + 1
        }
    }

    // 3. Honesty caveats: lattice-fit + n=6 cultural origin + FTL/CTC unproven.
    //    Per raw#10 C3 + LATTICE_POLICY §3.3.
    let caveats = [
        ["n=6 calendar is cultural, NOT physics-derived", "cultural"],
        ["No FTL sync claim allowed (c is HARD)",         "FTL"],
        ["Lattice-fit explanation disclaimed",            "lattice"],
    ]
    for c in caveats {
        let label = c[0]
        let needle = c[1]
        if _file_contains(audit, needle) {
            println("  [PASS] honesty caveat preserved: " + label)
            ok = ok + 1
        } else {
            println("  [FAIL] honesty caveat MISSING: " + label + " (needle: '" + needle + "')")
            bad = bad + 1
        }
    }

    println("")
    println("  anchors verified: " + str(ok) + "  failures: " + str(bad))
    println("  honesty: time travel (CTC / closed-timelike-curves) is UNPROVEN —")
    println("           no experimental evidence; causality preservation strict.")
    if bad > 0 {
        println("__HEXA_TIME_REAL_LIMITS_ANCHOR__ FAIL")
        exit(1)
    }
    println("__HEXA_TIME_REAL_LIMITS_ANCHOR__ PASS")
}
