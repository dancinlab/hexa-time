// install.hexa — hx build hook for hexa-time.
//
// Invoked by `hx install hexa-time` (hexa-lang package manager) right after
// the GitHub checkout (or symlink from /Users/ghost/core/hexa-time) lands in
// $HX_PKG_DIR. hx passes:
//   HX_PKG_DIR     — absolute path to the package root
//   HX_BIN_DIR     — ~/.hx/bin
//   HX_PKG_NAME    — "hexa-time"
//   HX_HOOK_PHASE  — "pre" | "post" | "both" (default: "both")
//
// Mirrors hexa-bio/install.hexa pattern (commit 2026-05-04).
//
// Responsibilities (each idempotent, raw#9 STRICT — no .py creation):
//   1. Pre-install: nothing (no python deps; pure-hexa spec substrate).
//   2. Post-install: run `hexa-time selftest` via the freshly-staged
//      cli/hexa-time.hexa. Selftest = sentinel sweep (3 verb specs present);
//      non-PASS = warn-only (not a blocker — spec substrate).
//
// raw#9 hexa-only, raw#11 snake_case, raw#15 no-hardcode.
// raw#10 honest C3: see hexa-time/README.md "Status" section.

fn run_quick_selftest(root: str) -> bool {
    let cli = root + "/cli/hexa-time.hexa"
    let exists = exec("[ -f \"" + cli + "\" ] && echo y || echo n").trim()
    if exists != "y" {
        eprintln("[hexa-time/install] WARN: cli/hexa-time.hexa missing — skip selftest")
        return false
    }
    println("[hexa-time/install] [post] running quick selftest (3-verb spec sentinel sweep)")
    let cmd = "HEXA_TIME_ROOT=\"" + root + "\" hexa run \"" + cli + "\" selftest 2>&1"
    let raw = exec(cmd)
    if raw.contains("__HEXA_TIME_SELFTEST__ PASS") {
        println("[hexa-time/install]   selftest PASS — 3/3 spec sentinels present")
        return true
    }
    eprintln("[hexa-time/install] WARN: selftest non-PASS (warn-only, not a blocker)")
    eprintln("  hint: missing spec file — see README §Status")
    return false
}

fn main() -> void {
    let mut root = env("HX_PKG_DIR")
    if root == "" { root = exec("pwd").trim() }
    let phase = env("HX_HOOK_PHASE")
    let mut p = phase
    if p == "" { p = "both" }
    println("[hexa-time/install] HX_PKG_DIR=" + root + " phase=" + p)

    let entry = root + "/cli/hexa-time.hexa"
    let entry_ok = exec("[ -f \"" + entry + "\" ] && echo y || echo n").trim()
    if entry_ok != "y" {
        eprintln("[hexa-time/install] ERROR: canonical entry missing: " + entry)
        exit(1)
    }
    println("[hexa-time/install] canonical entry OK: cli/hexa-time.hexa")

    if p == "post" || p == "both" {
        let _ = run_quick_selftest(root)  // warn-only
    }

    println("[hexa-time/install] done — hx will generate " + env("HX_BIN_DIR") + "/hexa-time shim")
}
